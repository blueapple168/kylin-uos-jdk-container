# syntax=docker/dockerfile:1.4
# Kylin Server V11 Minimal + Adoptium Temurin JDK 25  ——  x86_64 / arm64 统一构建
# 注意：本变体基础镜像为 Kylin V11 Minimal，包管理器与 UOS 变体不同，
# 因此 RUN 内按 microdnf -> dnf -> yum 顺序探测，不写死单一命令。

# 基础镜像：Kylin Server V11 Minimal
ARG BASE_IMAGE_TAG=v11-2503
ARG BASE_IMAGE_REPO=cr.kylinos.cn/kylin/kylin-server-minimal
FROM ${BASE_IMAGE_REPO}:${BASE_IMAGE_TAG}

# 重新声明基础镜像参数，供后续 LABEL 等指令展开（ARG 在 FROM 之后失效）
ARG BASE_IMAGE_TAG
ARG BASE_IMAGE_REPO

# buildx 自动注入的目标架构（amd64 / arm64）。必须声明才能引用，
# 否则 set -u 下引用未定义的 TARGETARCH 会报 unbound variable
ARG TARGETARCH

# JDKVER_RAW 写法 <版本号>+<build号>。下载链路由此推导：文件名把 + 换成 .，URL 路径把 + 转义为 %2B。
ARG JDKVER_RAW="25.0.5+8"

# 组件版本，均从 GitHub 官方 release 下载并做 sha256 校验；
# 内网可用 MIRROR_GITHUB 指向代理（留空则直连 github.com）
ARG DUMB_INIT_VER=1.2.5
ARG GOSU_VER=1.20
ARG OTEL_AGENT_VER=2.33.1
ARG MIRROR_GITHUB=""

ARG OS_VERSION=v11-2503

LABEL org.opencontainers.image.authors="blueapple1120@qq.com" \
      org.opencontainers.image.version="1.0" \
      org.opencontainers.image.base.name="${BASE_IMAGE_REPO}:${BASE_IMAGE_TAG}" \
      org.opencontainers.image.description="Adoptium Temurin JDK 25 on Kylin Linux ${OS_VERSION} (multi-arch: amd64/arm64)" \
      os="Kylin Linux" \
      os.version="${OS_VERSION}" \
      os.arch="amd64,arm64" \
      component="base-image"

ARG BIN_DIR=/usr/local/bin
ARG OTEL_HOME=/opt/otel/libs

RUN set -euxo pipefail; \
    # ---- 0. 架构判别（Adoptium 文件名用 x64/aarch64，与 TARGETARCH 不同） ----
    case "${TARGETARCH:-amd64}" in \
        amd64) TEMURIN_ARCH=x64;     DUMB_INIT_ASSET="dumb-init_${DUMB_INIT_VER}_x86_64";  GOSU_ASSET="gosu-amd64" ;; \
        arm64) TEMURIN_ARCH=aarch64; DUMB_INIT_ASSET="dumb-init_${DUMB_INIT_VER}_aarch64"; GOSU_ASSET="gosu-arm64" ;; \
        *) echo "ERROR: unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    GH="${MIRROR_GITHUB:-https://github.com}"; \
    DUMB_INIT_BASE="${GH}/Yelp/dumb-init/releases/download/v${DUMB_INIT_VER}"; \
    GOSU_BASE="${GH}/tianon/gosu/releases/download/${GOSU_VER}"; \
    OTEL_BASE="${GH}/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VER}"; \
    echo "==> TARGETARCH=${TARGETARCH}  TEMURIN_ARCH=${TEMURIN_ARCH}"; \
    \
    # ---- 1. 安装软件包 ----
    # 不写死单一包管理器。kylin 官方称 minimal 镜像用 microdnf，但实测
    # v11-2503 里执行 microdnf 报 command not found（exit 127），可能是 PATH
    # 或软链差异；platform/init 类镜像则用 yum / dnf。这里按优先级探测，
    # 同时查 PATH 与常见绝对路径，避免依赖镜像具体形态。
    PKG_MGR=""; \
    for m in microdnf dnf yum; do \
        if command -v "$m" >/dev/null 2>&1; then PKG_MGR="$(command -v "$m")"; break; fi; \
        for d in /usr/bin /bin /usr/sbin /sbin; do \
            if [ -x "${d}/${m}" ]; then PKG_MGR="${d}/${m}"; break 2; fi; \
        done; \
    done; \
    if [ -z "$PKG_MGR" ]; then \
        echo "ERROR: 未找到可用的包管理器 (microdnf/dnf/yum)" >&2; exit 1; \
    fi; \
    echo "==> 使用包管理器: ${PKG_MGR}"; \
    # 显式安装后续步骤真正依赖的命令所属包：minimal 镜像的精简度不明，
    # 缺 coreutils/gzip/shadow-utils/chkconfig 会在 RUN 中段以 127 失败，
    # 而报错位置离真实原因很远，很难定位。ca-certificates 缺了则 curl 直接报 SSL 错误。
    "$PKG_MGR" install -y \
        coreutils \
        gzip \
        tar \
        curl \
        ca-certificates \
        sed \
        gawk \
        grep \
        findutils \
        shadow-utils \
        chkconfig \
        glibc-langpack-zh; \
    \
    # ---- 2. 下载并解压 Temurin JDK ----
    mkdir -p /usr/lib/jvm "${OTEL_HOME}" /app; \
    # Temurin 资产名版本段用下划线拼接：25.0.5+8 -> 25.0.5_8
    FILE_VER=$(echo "$JDKVER_RAW" | tr '+' '_'); \
    # 下载路径的 tag 带 jdk- 前缀，且 + 需转义为 %2B：jdk-25.0.5%2B8
    URL_PATH="jdk-$(echo "$JDKVER_RAW" | sed 's/+/%2B/g')"; \
    JDK_URL="${GH}/adoptium/temurin25-binaries/releases/download/${URL_PATH}/OpenJDK25U-jdk_${TEMURIN_ARCH}_linux_hotspot_${FILE_VER}.tar.gz"; \
    echo "Downloading: ${JDK_URL}"; \
    curl -Lf --retry 5 --retry-delay 2 --connect-timeout 15 "$JDK_URL" -o /tmp/jdk.tar.gz; \
    # 用 sed 而非 head: head 会提前关闭管道让 tar 收到 SIGPIPE(141)，
    # 在 set -o pipefail + set -e 下会直接终止构建
    JDK_DIR=$(tar -tzf /tmp/jdk.tar.gz | sed -n '1s|/.*$||p'); \
    tar -xzf /tmp/jdk.tar.gz -C /usr/lib/jvm/; \
    rm -f /tmp/jdk.tar.gz; \
    ln -sfn "/usr/lib/jvm/${JDK_DIR}" /usr/lib/jvm/java; \
    \
    # ---- 3. 设置默认 Java ----
    # minimal 镜像不含 chkconfig(chkconfig 包)，update-alternatives 依赖它建链接，
    # 缺失会被绕过后 /usr/bin/java 不存在，直到 java -version 自检才报错
    for b in java javac jar jps; do \
        update-alternatives --install "/usr/bin/${b}" "${b}" "/usr/lib/jvm/java/bin/${b}" 1000; \
    done; \
    \
    # ---- 4. 在线安装 dumb-init + gosu ----
    mkdir -p /tmp/chk "${BIN_DIR}"; \
    curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 15 \
        "${DUMB_INIT_BASE}/sha256sums" -o /tmp/chk/dumb-init.sums; \
    curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 15 \
        "${DUMB_INIT_BASE}/${DUMB_INIT_ASSET}" -o "/tmp/chk/${DUMB_INIT_ASSET}"; \
    curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 15 \
        "${GOSU_BASE}/SHA256SUMS" -o /tmp/chk/gosu.sums; \
    curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 15 \
        "${GOSU_BASE}/${GOSU_ASSET}" -o "/tmp/chk/${GOSU_ASSET}"; \
    cd /tmp/chk; \
    grep " \*\?${DUMB_INIT_ASSET}\$" dumb-init.sums | sha256sum -c -; \
    grep " \*\?${GOSU_ASSET}\$" gosu.sums | sha256sum -c -; \
    install -m 0755 "/tmp/chk/${DUMB_INIT_ASSET}" "${BIN_DIR}/dumb-init"; \
    install -m 0755 "/tmp/chk/${GOSU_ASSET}" "${BIN_DIR}/gosu"; \
    cd /; \
    \
    # ---- 5. 在线下载 OpenTelemetry Java Agent 并校验 ----
    curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 15 \
        "${OTEL_BASE}/checksums.txt" -o /tmp/chk/otel.sums; \
    curl -fsSL --retry 5 --retry-delay 2 --connect-timeout 15 \
        "${OTEL_BASE}/opentelemetry-javaagent.jar" -o "${OTEL_HOME}/opentelemetry-javaagent.jar"; \
    cd "${OTEL_HOME}"; \
    grep " \*\?opentelemetry-javaagent.jar\$" /tmp/chk/otel.sums > /tmp/chk/jar.sums; \
    # 必须先确认校验条目非空，否则空输入会让 sha256sum 静默通过
    test -s /tmp/chk/jar.sums; \
    sha256sum -c /tmp/chk/jar.sums; \
    chmod 0644 "${OTEL_HOME}/opentelemetry-javaagent.jar"; \
    cd /; \
    \
    # ---- 6. 清理构建垃圾 ----
    rm -rf /tmp/chk; \
    case "$(basename "$PKG_MGR")" in \
        microdnf|dnf|yum) "$PKG_MGR" clean all ;; \
        *) : ;; \
    esac; \
    rm -rf /var/cache/yum/* \
           /var/cache/dnf/* \
           /var/cache/microdnf/* \
           /usr/lib/jvm/java/lib/src.zip \
           /usr/lib/jvm/java/src.zip \
           /var/tmp/* \
           /tmp/*; \
    \
    # ---- 7. 产物自检 ----
    /usr/lib/jvm/java/bin/java -version; \
    "${BIN_DIR}/dumb-init" --version; \
    "${BIN_DIR}/gosu" --version; \
    test -s "${OTEL_HOME}/opentelemetry-javaagent.jar"

COPY --chmod=755 docker-entrypoint.sh ${BIN_DIR}/docker-entrypoint.sh

# 堆占容器内存 75%，余 25% 留给 Metaspace / 线程栈 / DirectBuffer，降低 OOMKilled 概率
ENV JAVA_HOME=/usr/lib/jvm/java
ENV PATH=$JAVA_HOME/bin:$PATH \
    CLASSPATH=.:$JAVA_HOME/lib/dt.jar:$JAVA_HOME/lib/tools.jar \
    TZ=Asia/Shanghai \
    JAVA_OPTS="-XX:+UseContainerSupport \
               -XX:MaxRAMPercentage=75.0 \
               -XX:+UseZGC \
               -XX:+ZUncommit \
               -XX:ZUncommitDelay=300 \
               -XX:+HeapDumpOnOutOfMemoryError" \
    SECURERANDOM="-Djava.security.egd=file:/dev/./urandom" \
    JAVA_FILENAME_CODING="-Dsun.jnu.encoding=UTF-8 \
                          -Dfile.encoding=UTF-8 \
                          -Duser.country=CN \
                          -Duser.language=zh" \
    OTEL_HOME=/opt/otel/libs \
    JDK_CERT_URLS="" \
    RUN_ARGS="" \
    APP_NAME="app" \
    APP_USER="app"

ARG BIN_DIR=/usr/local/bin
RUN set -eux; \
    echo "${TZ}" > /etc/timezone; \
    groupadd -r "${APP_USER}" -g 1000; \
    useradd -r -u 1000 -g "${APP_USER}" -d "/${APP_USER}" -s /bin/bash "${APP_USER}"; \
    chown -R "${APP_USER}:${APP_USER}" "/${APP_USER}" /opt/otel; \
    chmod +x "${BIN_DIR}"/*; \
    echo '. ~/.bashrc' > "/${APP_USER}/.bash_profile"; \
    echo '. /etc/profile' > "/${APP_USER}/.bashrc"

WORKDIR /${APP_USER}

ENTRYPOINT ["/usr/local/bin/dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]

CMD ["/bin/sh", "-c", "java ${JAVA_OPTS} ${SECURERANDOM} ${JAVA_FILENAME_CODING} -jar ${APP_NAME}.jar ${RUN_ARGS}"]
